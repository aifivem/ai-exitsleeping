{
  "name": "ai-exitsleeping",
  "version": "0.1.1",
  "private": true,
  "description": "Players who log out stay in the world as a sleeping ped at their last location; others can carry it or put it into a vehicle, and the owner wakes up where the ped ended up.",
  "license": "GPL-3.0-only",
  "author": {
    "name": "TGIANN"
  },
  "repository": "github:aifivem/ai-exitsleeping",
  "type": "module",
  "fxDependencies": [
    "/onesync",
    "ai-core"
  ],
  "scripts": {
    "lint": "oxlint --ignore-pattern \"dist/**\"",
    "format": "prettier --write .",
    "dev": "bun tsdown -- --watch",
    "build": "aicore-db-types && bun tsdown -- && aicore-client-errors dist/client.js",
    "typecheck": "tsc --noEmit -p resource/client/tsconfig.json && tsc --noEmit -p resource/server/tsconfig.json",
    "bench": "bun bench/run.ts store"
  },
  "dependencies": {
    "@aicore-fivem/lib": "workspace:*",
    "@aicore-fivem/shared": "workspace:*",
    "@aicore-fivem/mysql": "workspace:*"
  },
  "devDependencies": {
    "@aicore-fivem/build": "workspace:*",
    "@citizenfx/client": "latest",
    "@citizenfx/server": "latest",
    "@types/bun": "latest",
    "@types/node": "^22",
    "fast-glob": "^3.3.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "oxlint": "^1.66.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3"
  },
  "fxFiles": [
    "data/settings.json"
  ]
}
